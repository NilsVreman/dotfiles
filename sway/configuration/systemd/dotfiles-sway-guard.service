[Unit]
Description=Dotfiles Sway compositor-lifetime guard
PartOf=dotfiles-sway-session.target
Requires=dotfiles-sway-cleanup.service
After=dotfiles-sway-cleanup.service
Before=dotfiles-sway-session.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%t/dotfiles-sway-session/environment
ExecStart=/usr/bin/python3 ${DOTFILES_SWAY_CONFIG}/scripts/session.py guard
TimeoutStartSec=10
TimeoutStopSec=10
KillMode=control-group
Restart=no
